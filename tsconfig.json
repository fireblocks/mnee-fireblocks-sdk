{
  "compilerOptions": {
    "target": "ES2020",
    "types": ["node"],
    "isolatedModules": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "strict": false,
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*", "test.ts"]
}
