{
  "name": "mnee-fireblocks-sdk",
  "version": "1.0.0",
  "description": "MNEE token operations using Fireblocks",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watchAll",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "start": "tsx main.ts",
    "clean": "rm -rf dist",
    "build": "tsc",
    "pack": "npm run clean && npm run build && npm pack"
  },
  "keywords": [],
  "author": "Slava Serebrianniy",
  "license": "ISC",
  "dependencies": {
    "@bsv/sdk": "1.3.30",
    "@fireblocks/ts-sdk": "^10.0.1",
    "@mnee/ts-sdk": "^1.1.2",
    "axios": "^1.8.4",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "fs": "^0.0.1-security",
    "js-1sat-ord": "^0.1.80",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.19",
    "axios-mock-adapter": "^1.22.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "ts-jest": "^29.3.2",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
